# Local: copy to `.env.local`. Production: add each key in Vercel → Project → Settings → Environment Variables (Production + Preview as needed).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional backend API base URL
# VITE_API_URL=

# Web OAuth callback base (no trailing slash). Use your Vercel URL or custom domain, e.g. https://notaresume.vercel.app
# VITE_BASE_URL=

# Visitor analytics email (Web3Forms)
# VITE_WEB3FORMS_ACCESS_KEY=

# Optional Capacitor / native OAuth bases (no trailing slash)
# VITE_IOS_REDIRECT_URL=
# VITE_ANDROID_REDIRECT_URL=
